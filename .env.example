# --- Pflicht --------------------------------------------------------------
# Admin-Schluessel fuer /admin (mind. 16 Zeichen, zufaellig). Erzeugen z. B. mit:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# Oeffentliche Adresse des Servers (fuer die Einladungslinks), ohne Schraegstrich am Ende
PUBLIC_URL=https://fmm-live-moderator.fly.dev
# Anthropic-API-Schluessel (nur auf dem Server! nie an Streamer weitergeben)
ANTHROPIC_API_KEY=

# --- Optional -------------------------------------------------------------
# KI-Modell: claude-opus-5-5 (Standard, beste Qualitaet) oder claude-haiku-5-5 (ca. 97 % guenstiger)
LM_MODEL=claude-opus-5-5
LM_EFFORT=low
# Tageslimit KI-Kosten je Streamer in USD (danach nur Regelpruefung). 0 = ohne Limit
AI_DAILY_BUDGET_USD=5
# Euler-Stream-Schluessel fuer hoehere Lese-Kontingente (nur bei vielen Streamern noetig)
SIGN_API_KEY=
# Chat-Daten werden nach so vielen Tagen geloescht
RETENTION_DAYS=30
# Wie oft (Sekunden) pro Streamer geprueft wird, ob ein LIVE laeuft
LIVE_POLL_SECONDS=60
# Speicherort der Datenbank
DATA_DIR=./data
# Notschalter
AI_ENABLED=true
TIKTOK_ENABLED=true
# Optionaler HTTP-Proxy fuer TikTok-Abfragen (nur falls TikTok die Cloud-IP blockiert)
TIKTOK_PROXY=
